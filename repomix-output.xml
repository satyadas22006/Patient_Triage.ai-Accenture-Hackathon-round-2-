            f"&middot; Risk Score {result.risk_score:.2f} "
            f"&middot; <i>Recommended — nurse confirms</i></div>",
            unsafe_allow_html=True,
        )

        st.markdown("**Auto-Triggered Actions**")
        if result.decisions:
            for d in result.decisions:

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/patienttriage
SQLALCHEMY_DATABASE_URL=postgresql://user:password@localhost:5432/patienttriage

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ENVIRONMENT=development

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# Authentication
API_KEY_HEADER=X-API-Key
SECRET_KEY=your-secret-key-here

# NLP Settings
NLP_MODEL=facebook/bart-large-mnli
NLP_DEVICE=cpu

# Logging
LOG_LEVEL=INFO
